# Required: signs login sessions and per-trip calendar-feed tokens.
# Use the same value as the old site so existing calendar subscriptions keep working.
TRAVEL_SESSION_SECRET=
# Production database (Turso). Leave unset locally to use .data/travel.db.
TRAVEL_DATABASE_URL=
TRAVEL_DATABASE_AUTH_TOKEN=
# Optional fallback logins: JSON of {"user":"salt:hash"} (prefer scripts/set-password.mjs).
TRAVEL_USERS=
# Shared secret for Llamabear's read-only /api/feed.
TRAVEL_FEED_SECRET=
